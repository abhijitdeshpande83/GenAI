    "import os, sys\n",
    "sys.path.append(os.path.abspath(\"..\")) \n",
    "from src.state_schema import SupervisorState\n",
    "from src.supervisor_graph import supervisor_node\n",
    "from src.complaint_graph import complaint_flow\n",
    "from src.inquiry_graph import inquiry_flow\n",
    "from src.retention_graph import retention_flow\n",
    "from src.conversation_graph import greeting_node, clarification_node"
    "from src.conversation_graph import greeting_flow, clarification_flow\n",
    "from rich import print as rprint"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "9f861582",
   "metadata": {},
   "outputs": [],
   "source": [
    "from langgraph.graph import StateGraph, START, END, MessagesState\n",
    "from langgraph.checkpoint.memory import MemorySaver"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "5a5e09f5",
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_graph():\n",
    "\n",
    "    graph = StateGraph(SupervisorState)\n",
    "\n",
    "    graph.add_node(\"supervisor\",supervisor_node)\n",
    "    graph.add_node(\"greeting_flow\",greeting_node)\n",
    "    graph.add_node(\"clarification_flow\", clarification_node)\n",
    "    graph.add_node(\"complaint_flow\", complaint_flow)\n",
    "    graph.add_node(\"retention_flow\", retention_flow)\n",
    "    graph.add_node(\"inquiry_flow\", inquiry_flow)\n",
    "\n",
    "    graph.add_edge(START, \"supervisor\")\n",
    "    graph.add_edge(\"greeting_flow\", END)\n",
    "    graph.add_edge(\"clarification_flow\", END)\n",
    "\n",
    "    memory = MemorySaver()\n",
    "    return graph.compile(checkpointer=memory)\n",
    "\n",
    "graph = build_graph()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "127e87d4",
   "metadata": {},
   "outputs": [],
   "source": [
    "def agent(state:SupervisorState)->SupervisorState:\n",
    "    config = {\"configurable\": {\"thread_id\": \"support_session_1\"}}\n",
    "    return graph.invoke(state,config)"
   ]
  },
  {
   "cell_type": "code",
