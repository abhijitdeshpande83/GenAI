    "    top_label = result[\"labels\"][0]\n",
    "    top_score = result[\"scores\"][0]\n",
    "    second_score = result[\"scores\"][1]\n",
    "    margin = top_score - second_score\n",
    "    print(f\"\\n'{msg}'\")\n",
    "    print(f\"  → {top_label[:50]}\")\n",
    "    print(f\"  score: {top_score:.2f}  margin: {margin:.2f}\")\n"
   ]
